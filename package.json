{
  "name": "bible-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-bible.mjs",
    "predev": "npm run data",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch server/index.ts\" \"vite\"",
    "prebuild": "npm run data",
    "build": "tsc && vite build",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "express": "^4.21.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "world-english-bible": "^1.0.1"
  }
}
