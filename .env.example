# API.Bible (https://api.bible) — required for the NKJV. Without these the app serves
# the public-domain World English Bible as development text.
BIBLE_API_KEY=
# Bible id for the NKJV on your API.Bible account; find it with `npm run find-bible`.
BIBLE_ID=
# Label shown next to the text.
BIBLE_TRANSLATION=NKJV
# How long fetched chapters stay in server memory (minutes). Text is never written to disk.
BIBLE_CACHE_TTL_MINUTES=60
# Override only if API.Bible gives you a different base URL.
# BIBLE_API_BASE=https://rest.api.bible/v1
PORT=8787
